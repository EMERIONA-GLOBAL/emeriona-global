{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emeriona-global",
  "main": "./apps/api/index.ts",
  "compatibility_date": "2026-09-10",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{ "binding": "DB", "database_name": "emeriona-global-db", "database_id": "7109ca59-08bd-4330-9b99-37fce16b6203", "migrations_dir": "./database/migrations" }],
  "workflows": [{ "binding": "EMERIONA_CORE_WORKFLOW", "name": "emeriona-core-workflow", "class_name": "EmerionaCoreWorkflow" }],
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/discovery.html", "/discovery-current.html", "/discovery-live-20261004", "/discovery-live-20261004.html", "/discovery-final-20261004.html", "/discovery-page-clean.css", "/discovery-page-final.css"]
  }
}
